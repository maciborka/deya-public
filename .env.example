# IP и серийник WiFi-логгера Solarman (наклейка на логгере / его веб-интерфейс)
DEYA_LOGGER_IP=192.168.1.50
DEYA_LOGGER_SERIAL=1234567890
DEYA_LOGGER_PORT=8899
DEYA_POLL_SEC=10
DEYA_FULL_POLL_SEC=300
DEYA_FORECAST_HOURS=5,11,17,21
# Postgres (пароль и ключ сгенерировать: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
POSTGRES_DB=deya
POSTGRES_USER=deya
POSTGRES_PASSWORD=change-me
# Django-админка
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Fallback-ключ Solcast, если в админке ключ не задан
SOLCAST_API_KEY=
# Внешний доступ (Cloudflare Tunnel): токен коннектора из Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
# включить сервис cloudflared
COMPOSE_PROFILES=tunnel
# https-адреса админки через туннель, напр. https://admin.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Вход на дашборд (HTTP Basic), пароль сгенерировать как выше
DEYA_WEB_USER=deya
DEYA_WEB_PASSWORD=
